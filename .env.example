# Neon Postgres — pooled connection string
DATABASE_URL=

# Google Search Console service account key (JSON file path)
GSC_KEY_FILE=.secrets/gsc.json
GSC_SITE=sc-domain:gethelium.co

# Drafting model. LLM_PROVIDER selects the adapter in lib/llm.
LLM_PROVIDER=ollama

# Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
# Exact tag as Ollama lists it, e.g. glm-4.6:cloud
LLM_MODEL=

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=

# Discord channel webhook (phase 4)
DISCORD_WEBHOOK_URL=
