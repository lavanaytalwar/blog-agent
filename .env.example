# Neon Postgres — pooled connection string
DATABASE_URL=

# Google Search Console service account key (JSON file path)
GSC_KEY_FILE=.secrets/gsc.json
GSC_SITE=sc-domain:gethelium.co

# Drafting model. LLM_PROVIDER selects the adapter in lib/llm.
LLM_PROVIDER=ollama

# Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
# Exact tag as Ollama lists it, e.g. glm-5.2
LLM_MODEL=
# Reasoning effort for models that support it: max | high | medium | low | true | false
OLLAMA_THINK=high

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=

# Search provider for `npm run serp:analyze`. Any one, or none: with no key the
# top-6 URLs are passed on the command line instead. Checked in this order.
# Apify runs an actor, so it is slower than the other two but its free monthly
# credit covers this workload many times over.
APIFY_TOKEN=
APIFY_SEARCH_ACTOR=apify~google-search-scraper
BRAVE_SEARCH_KEY=
SERPER_API_KEY=

# Discord channel webhook (phase 4)
DISCORD_WEBHOOK_URL=

# Dashboard auth. Vercel's deployment protection excludes production domains on
# the free plan, so middleware.ts does it instead: HTTP Basic for people, a
# bearer token for Vercel Cron. Unset is allowed locally and refused on a
# production deployment. Generate with:
#   openssl rand -base64 24   # DASHBOARD_PASSWORD
#   openssl rand -hex 32      # CRON_SECRET
DASHBOARD_PASSWORD=
CRON_SECRET=
